{
  "manifest_version": 3,
  "name": "KomeMaku - YouTube Comment Danmaku",
  "short_name": "KomeMaku",
  "description": "YouTubeのコメントを動画上に弾幕表示。YCS Continued連携、4言語、色・速度・サイズ設定、再生位置同期に対応。",
  "version": "1.8.9",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KomeMaku",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ycs-parser.js",
        "ycs-bridge.js",
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "player.css"
      ],
      "js": [
        "ycs-parser.js",
        "logic.js",
        "i18n.js",
        "renderer-webgl.js",
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "live-chat.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scheduler-host.html",
        "scheduler-host.js",
        "scheduler-worker.js",
        "logic.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
